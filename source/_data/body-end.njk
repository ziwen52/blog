<script>
(() => {
  const init = () => {
    const overlay = document.createElement('div');
    const close = document.createElement('button');
    const preview = document.createElement('img');
    overlay.className = 'blog-image-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '图片预览');
    close.type = 'button';
    close.setAttribute('aria-label', '关闭图片预览');
    close.textContent = '×';
    overlay.append(close, preview);
    document.body.append(overlay);

    const closeOverlay = () => {
      overlay.classList.remove('is-open');
      document.body.classList.remove('blog-image-lightbox-open');
      preview.removeAttribute('src');
    };

    close.addEventListener('click', closeOverlay);
    overlay.addEventListener('click', event => {
      if (event.target === overlay) closeOverlay();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeOverlay();
    });

    const attachPreview = image => {
      image.loading = 'lazy';
      image.addEventListener('click', () => {
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt || '文章图片预览';
        overlay.classList.add('is-open');
        document.body.classList.add('blog-image-lightbox-open');
      });
    };

    const directImages = paragraph => [...paragraph.querySelectorAll(':scope > img')];
    const isImageOnlyParagraph = paragraph => {
      const images = directImages(paragraph);
      return images.length > 0 && [...paragraph.childNodes].every(node =>
        (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'IMG') ||
        (node.nodeType === Node.TEXT_NODE && !node.textContent.trim())
      );
    };

    const mountGallery = (anchor, images, removeParagraphs) => {
      const gallery = document.createElement('div');
      gallery.className = 'image-gallery image-gallery--' + Math.min(images.length, 9);
      anchor.before(gallery);
      images.forEach(image => {
        attachPreview(image);
        gallery.append(image);
      });
      removeParagraphs.forEach(paragraph => paragraph.remove());
    };

    document.querySelectorAll('.post-body').forEach(body => {
      const paragraphs = [...body.querySelectorAll('p')];
      for (let index = 0; index < paragraphs.length;) {
        const paragraph = paragraphs[index];
        if (!paragraph.isConnected) {
          index += 1;
          continue;
        }

        if (isImageOnlyParagraph(paragraph)) {
          const group = [paragraph];
          let next = index + 1;
          while (next < paragraphs.length && isImageOnlyParagraph(paragraphs[next])) {
            group.push(paragraphs[next]);
            next += 1;
          }
          mountGallery(paragraph, group.flatMap(directImages), group);
          index = next;
          continue;
        }

        const images = directImages(paragraph);
        if (images.length) {
          const gallery = document.createElement('div');
          gallery.className = 'image-gallery image-gallery--' + Math.min(images.length, 9);
          paragraph.insertBefore(gallery, images[0]);
          images.forEach(image => {
            attachPreview(image);
            gallery.append(image);
          });
        }
        index += 1;
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>
