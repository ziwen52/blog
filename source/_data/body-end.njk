<script>
(() => {
  const init = () => {
    const overlay = document.createElement('div');
    const close = document.createElement('button');
    const preview = document.createElement('img');
    overlay.className = 'blog-image-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '图片预览');
    close.type = 'button';
    close.setAttribute('aria-label', '关闭图片预览');
    close.textContent = '×';
    overlay.append(close, preview);
    document.body.append(overlay);

    const closeOverlay = () => {
      overlay.classList.remove('is-open');
      document.body.classList.remove('blog-image-lightbox-open');
      preview.removeAttribute('src');
    };

    close.addEventListener('click', closeOverlay);
    overlay.addEventListener('click', event => {
      if (event.target === overlay) closeOverlay();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeOverlay();
    });

    document.querySelectorAll('.post-body p').forEach(paragraph => {
      const images = [...paragraph.querySelectorAll(':scope > img')];
      if (!images.length) return;

      const gallery = document.createElement('div');
      const count = Math.min(images.length, 9);
      gallery.className = 'image-gallery image-gallery--' + count;
      paragraph.insertBefore(gallery, images[0]);

      images.forEach(image => {
        image.loading = 'lazy';
        image.addEventListener('click', () => {
          preview.src = image.currentSrc || image.src;
          preview.alt = image.alt || '文章图片预览';
          overlay.classList.add('is-open');
          document.body.classList.add('blog-image-lightbox-open');
        });
        gallery.append(image);
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>
