/*
 * Apple-inspired refinement for 王子文的博客.
 * Uses SF Pro automatically on Apple devices through the system font stack.
 */
@view-transition {
  navigation: auto;
}

::view-transition-old(root),
::view-transition-new(root) {
  animation-duration: 180ms;
  animation-timing-function: ease-out;
}

:root {
  --body-bg-color: #f5f5f7;
  --content-bg-color: #ffffff;
  --card-bg-color: #ffffff;
  --text-color: #1d1d1f;
  --selection-bg: #0071e3;
  --selection-color: #ffffff;
  --blockquote-color: #515154;
  --link-color: #0066cc;
  --link-hover-color: #0071e3;
  --brand-color: #1d1d1f;
  --brand-hover-color: #0066cc;
  --table-row-odd-bg-color: #fbfbfd;
  --table-row-hover-bg-color: #f5f5f7;
  --menu-item-bg-color: transparent;
  --theme-color: #ffffff;
  --btn-default-bg: #ffffff;
  --btn-default-color: #0066cc;
  --btn-default-border-color: #d2d2d7;
  --btn-default-hover-bg: #0071e3;
  --btn-default-hover-color: #ffffff;
  --btn-default-hover-border-color: #0071e3;
}

html {
  background: #f5f5f7;
  scroll-behavior: smooth;
}

body {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Helvetica Neue", "Segoe UI", sans-serif;
  font-size: 16px;
  font-weight: 400;
  letter-spacing: -0.011em;
  line-height: 1.72;
}

a,
button,
.menu-item a,
.post-title-link,
.site-state-item a {
  transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}

a {
  color: #0066cc;
}

a:hover {
  color: #0071e3;
  text-decoration: none;
}

.headband {
  display: none;
}

.main {
  padding: 28px 20px 72px;
}

.column {
  max-width: 1160px;
  margin: 0 auto;
}

.header {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 22px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  -webkit-backdrop-filter: saturate(180%) blur(18px);
  backdrop-filter: saturate(180%) blur(18px);
  overflow: hidden;
}

.site-brand-container {
  min-height: 82px;
  padding: 16px 28px;
}

.site-title {
  color: #1d1d1f;
  font-size: 22px;
  font-weight: 650;
  letter-spacing: -0.04em;
}

.site-subtitle {
  color: #6e6e73;
  font-size: 13px;
  letter-spacing: 0;
  margin-top: 3px;
}

.site-nav {
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  margin: 0;
  padding: 8px 20px;
}

.menu {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.menu-item {
  margin: 0;
}

.menu-item a {
  border-radius: 999px;
  color: #424245;
  font-size: 14px;
  padding: 7px 12px;
}

.menu-item a:hover,
.menu-item-active a {
  background: #e8f2ff;
  color: #0066cc;
  transform: translateY(-1px);
}

.menu-item i {
  margin-right: 5px;
}

.sidebar {
  background: transparent;
}

.sidebar-inner {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 22px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  -webkit-backdrop-filter: saturate(180%) blur(18px);
  backdrop-filter: saturate(180%) blur(18px);
  overflow: hidden;
}

.sidebar-nav {
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.sidebar-nav li {
  color: #6e6e73;
  font-size: 13px;
}

.sidebar-nav li.sidebar-nav-active {
  border-bottom-color: #0071e3;
  color: #0066cc;
}

.site-author-name {
  color: #1d1d1f;
  font-size: 18px;
  font-weight: 650;
  letter-spacing: -0.025em;
}

.site-description {
  color: #6e6e73;
  font-size: 13px;
  line-height: 1.55;
}

.site-state-item a {
  border-radius: 12px;
  padding: 8px 3px;
}

.site-state-item a:hover {
  background: #f5f5f7;
  color: #0066cc;
}

.site-state-item-count {
  color: #1d1d1f;
  font-size: 19px;
  font-weight: 600;
}

.site-state-item-name {
  color: #86868b;
  font-size: 12px;
}

.main-inner {
  padding-top: 24px;
}

.post-block {
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 22px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.045);
  margin-bottom: 20px;
  padding: 32px 36px;
}

.post-block:hover {
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.075);
}

.post-title {
  font-size: clamp(26px, 3vw, 34px);
  font-weight: 650;
  letter-spacing: -0.045em;
  line-height: 1.18;
}

.post-title-link {
  color: #1d1d1f;
}

.post-title-link:hover {
  color: #0066cc;
}

.post-meta {
  color: #86868b;
  font-size: 13px;
  letter-spacing: 0;
  margin-top: 11px;
}

.post-meta a {
  color: #6e6e73;
}

.post-meta a:hover {
  color: #0066cc;
}

.post-body {
  color: #424245;
  font-size: 17px;
  line-height: 1.8;
}

.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4 {
  color: #1d1d1f;
  font-weight: 650;
  letter-spacing: -0.032em;
  line-height: 1.25;
}

.post-body h2 {
  font-size: 26px;
  margin-top: 2.2em;
}

.post-body blockquote {
  background: #f5f5f7;
  border-left: 3px solid #0071e3;
  border-radius: 0 12px 12px 0;
  color: #515154;
  margin: 1.5em 0;
  padding: 12px 18px;
}

.post-body code {
  background: #f5f5f7;
  border-radius: 6px;
  color: #b42318;
  padding: 0.14em 0.38em;
}

.post-body .highlight,
.post-body pre {
  border-radius: 14px;
}

.post-button .btn {
  border-color: #d2d2d7;
  border-radius: 999px;
  color: #0066cc;
  font-weight: 500;
  padding: 7px 16px;
}

.post-button .btn:hover {
  background: #0071e3;
  border-color: #0071e3;
  color: #ffffff;
}

.pagination {
  margin: 32px 0 0;
}

.pagination .page-number,
.pagination .extend {
  border-radius: 999px;
  margin: 0 2px;
  transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
}

.pagination .page-number:hover,
.pagination .extend:hover,
.pagination .current {
  background: #0071e3;
  color: #ffffff;
}

.footer {
  color: #86868b;
  font-size: 12px;
  padding: 28px 0 0;
}

.popup {
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 18px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
}

@media (prefers-color-scheme: dark) {
  :root {
    --body-bg-color: #000000;
    --content-bg-color: #1d1d1f;
    --card-bg-color: #1d1d1f;
    --text-color: #f5f5f7;
    --link-color: #2997ff;
    --link-hover-color: #64b5ff;
    --brand-color: #f5f5f7;
    --brand-hover-color: #2997ff;
  }

  html,
  body {
    background: #000000;
  }

  .header,
  .sidebar-inner {
    background: rgba(29, 29, 31, 0.78);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .site-title,
  .site-author-name,
  .site-state-item-count,
  .post-title-link,
  .post-body h1,
  .post-body h2,
  .post-body h3,
  .post-body h4 {
    color: #f5f5f7;
  }

  .post-block {
    background: #1d1d1f;
    border-color: rgba(255, 255, 255, 0.09);
    box-shadow: none;
  }

  .post-block:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
  }

  .post-body {
    color: #d2d2d7;
  }

  .site-state-item a:hover,
  .menu-item a:hover,
  .menu-item-active a,
  .post-body blockquote,
  .post-body code {
    background: #2c2c2e;
  }

  .site-nav,
  .sidebar-nav {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .menu-item a,
  .post-meta a {
    color: #d2d2d7;
  }

  .post-meta,
  .site-subtitle,
  .site-description,
  .site-state-item-name,
  .footer {
    color: #a1a1a6;
  }
}

@media (max-width: 767px) {
  .main {
    padding: 12px 12px 48px;
  }

  .header,
  .sidebar-inner,
  .post-block {
    border-radius: 16px;
  }

  .site-brand-container {
    min-height: 70px;
    padding: 12px 16px;
  }

  .site-title {
    font-size: 19px;
  }

  .site-nav {
    padding: 7px 10px;
  }

  .menu {
    gap: 2px;
  }

  .menu-item a {
    font-size: 13px;
    padding: 6px 9px;
  }

  .main-inner {
    padding-top: 12px;
  }

  .post-block {
    margin-bottom: 12px;
    padding: 24px 20px;
  }

  .post-body {
    font-size: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
